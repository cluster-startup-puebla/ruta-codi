---
import follow from "../data/follow.json";

const section = follow.allies;
---

{
  section.enabled && (
    <section id={section.id} class="border-t border-line bg-paper px-4 py-14 sm:px-6 sm:py-16">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-sm font-medium tracking-[0.18em] text-mute uppercase">{section.title}</h2>
        <p class="mx-auto mt-4 max-w-[42ch] leading-relaxed text-mute">{section.intro}</p>
        {section.items.length === 0 ? (
          <p class="mt-8 leading-relaxed">{section.empty}</p>
        ) : (
          <ul class="mt-8 grid grid-cols-2 items-center justify-items-center gap-x-6 gap-y-8 sm:gap-x-10 lg:grid-cols-4">
            {section.items.map((ally) => (
              <li class="flex h-16 w-full items-center justify-center sm:h-20">
                <a href={ally.href} target="_blank" rel="noopener noreferrer" aria-label={ally.name} class="inline-block py-2">
                  <img
                    src={ally.logo}
                    alt=""
                    width={ally.width}
                    height={ally.height}
                    class="max-h-12 w-auto max-w-full object-contain sm:max-h-16"
                  />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}
