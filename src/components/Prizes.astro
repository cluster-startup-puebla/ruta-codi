---
import follow from "../data/follow.json";

const section = follow.prizes;
const prizes = section.items as { title: string; detail: string }[];
---

{
  section.enabled && (
    <section id={section.id} class="px-4 py-16 sm:px-6 sm:py-24">
      <div class="mx-auto max-w-6xl">
        <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">{section.title}</h2>
        <p class="mt-4 font-display text-xl font-semibold text-rose-deep">{section.status}</p>
        <p class="mt-3 max-w-[62ch] text-lg leading-relaxed text-mute">{section.text}</p>
        {prizes.length > 0 && (
          <ul class="mt-8 border-t border-line">
            {prizes.map((prize) => (
              <li class="border-b border-line py-4">
                <p class="font-display text-lg font-medium">{prize.title}</p>
                <p class="mt-1 text-mute">{prize.detail}</p>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}
