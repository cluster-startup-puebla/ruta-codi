---
import follow from "../data/follow.json";

const section = follow.join;
---

{
  section.enabled && (
    <section id={section.id} class="px-4 py-16 sm:px-6 sm:py-24">
      <div class="mx-auto max-w-6xl">
        <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">{section.title}</h2>
        <ul class="mt-10 grid gap-8 md:grid-cols-3 md:gap-6">
          {section.items.map((path) => (
            <li>
              <p class="font-display text-lg font-medium">{path.who}</p>
              <p class="mt-2 leading-relaxed text-mute">{path.text}</p>
              <a
                href={path.href}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex min-h-11 items-center font-medium text-rose-deep underline decoration-rose/40 underline-offset-4"
              >
                {path.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
