---
import follow from "../data/follow.json";

const section = follow.talks;
const talks = section.items as { title: string; speaker: string; org?: string }[];
---

{
  section.enabled && (
    <section id={section.id} class="px-4 py-16 sm:px-6 sm:py-24">
      <div class="mx-auto max-w-6xl">
        <h2 class="max-w-[16ch] font-display text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          {section.title}
        </h2>
        <p class="mt-4 max-w-[62ch] text-lg leading-relaxed text-mute">{section.intro}</p>
        {talks.length === 0 ? (
          <p class="mt-8 max-w-[62ch] border-t border-line pt-5 leading-relaxed">{section.empty}</p>
        ) : (
          <ul class="mt-8 border-t border-line">
            {talks.map((talk) => (
              <li class="border-b border-line py-5">
                <p class="font-display text-xl font-medium">{talk.title}</p>
                <p class="mt-1 text-mute">
                  {talk.speaker}
                  {talk.org ? ` · ${talk.org}` : ""}
                </p>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}
